<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCPartsStore.ViewModels"
        x:Class="PCPartsStore.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PC Parts Store"
        Width="1000" Height="650"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="200,*">

    <!-- Left navigation sidebar -->
    <Border Grid.Column="0"
            Background="#3EB8DA"
            Padding="16">
      <StackPanel Spacing="8">

        <TextBlock Text="PC Parts Store"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,24"/>

        <Button Content="Catalog"
                Command="{Binding NavigateToCatalogCommand}"
                HorizontalAlignment="Stretch"/>

        <Button Content="Cart"
                Command="{Binding NavigateToCartCommand}"
                HorizontalAlignment="Stretch"/>

        <Button Content="Order History"
                Command="{Binding NavigateToOrderHistoryCommand}"
                HorizontalAlignment="Stretch"/>

        <Button Content="Admin"
                Command="{Binding NavigateToAdminCommand}"
                HorizontalAlignment="Stretch"/>

      </StackPanel>
    </Border>

    <!-- Right content area — shows current view -->
    <ContentControl Grid.Column="1"
                    Content="{Binding CurrentView}"/>

  </Grid>
</Window>