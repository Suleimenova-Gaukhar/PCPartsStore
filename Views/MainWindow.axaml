<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCPartsStore.ViewModels"
        x:Class="PCPartsStore.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PC Parts Store"
        Width="1100" Height="650"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="Auto,*">

    <Border Grid.Column="0"
            Background="#592E83"
            Padding="20"
            Width="220"
            IsVisible="{Binding IsSidebarVisible}">

      <DockPanel>

        <!-- Switch account button at the bottom -->
        <Button DockPanel.Dock="Bottom"
                Content="← Switch account"
                Command="{Binding SwitchAccountCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                Foreground="#FFFFFF"
                FontSize="13"
                Padding="8,10"
                Margin="0,16,0,0"/>

        <!-- Navigation buttons at the top -->
        <StackPanel Spacing="4">

          <!-- Customer sidebar -->
          <TextBlock Text="Customer account"
                     HorizontalAlignment="Center"
                     Foreground="White"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Opacity="0.7"
                     IsVisible="{Binding IsCustomer}"
                     Margin="0,0,0,16"/>

          <Button Content="Catalog"
                  Command="{Binding NavigateToCatalogCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="8,10"
                  IsVisible="{Binding IsCustomer}"/>

          <Button Content="Cart"
                  Command="{Binding NavigateToCartCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="8,10"
                  IsVisible="{Binding IsCustomer}"/>

          <Button Content="My orders"
                  Command="{Binding NavigateToMyOrdersCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="8,10"
                  IsVisible="{Binding IsCustomer}"/>

          <!-- Admin sidebar -->
          <TextBlock Text="Admin account"
                     HorizontalAlignment="Center"
                     Foreground="White"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Opacity="0.7"
                     IsVisible="{Binding IsAdmin}"
                     Margin="0,0,0,16"/>

          <Button Content="Products"
                  Command="{Binding NavigateToProductsCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="8,10"
                  IsVisible="{Binding IsAdmin}"/>

          <Button Content="All orders"
                  Command="{Binding NavigateToAllOrdersCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="8,10"
                  IsVisible="{Binding IsAdmin}"/>

          <Button Content="Statistics"
                  Command="{Binding NavigateToStatisticsCommand}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Background="Transparent"
                  Foreground="White"
                  FontSize="14"
                  FontWeight="SemiBold"
                  Padding="8,10"
                  IsVisible="{Binding IsAdmin}"/>

        </StackPanel>

      </DockPanel>

    </Border>

    <!-- Right content area -->
    <ContentControl Grid.Column="1"
                    Content="{Binding CurrentView}"/>

  </Grid>

</Window>